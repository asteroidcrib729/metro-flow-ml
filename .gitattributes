# Normalize line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Force LF on source, config, notebook, and text data files
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.html text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.python-version text eol=lf

# Binary assets
*.png binary
*.pkl binary
